// Camera2 NDK to MJPEG bridge. Enabled in v22 — see README.md.
cc_binary {
    name: "webcam_bridge",
    srcs: ["webcam_bridge.cpp"],
    shared_libs: [
        "libcamera2ndk",
        "libmediandk",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    cpp_std: "c++17",
}
